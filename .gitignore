# ==============================================================================
# Antigravity Skills Toolkit - Production Git Ignore Rules
# ==============================================================================

# 1. Environment variables and secrets (NEVER commit real credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore

# 2. Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.tmp
*.bak

# 3. Editor and IDE configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# 4. Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 5. Node / Web build artifacts and dependencies
node_modules/
.npm
.yarn/
.next/
out/
build/
dist/
.vercel/
.turbo/

# 6. Local Agent, IDE & AI tool runtime caches
.gemini/
scratch/
brain/
*.log
local_logs/
.agents/local/

# 7. Archives and temporary data
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
