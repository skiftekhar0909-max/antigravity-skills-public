# ==============================================================================
# Antigravity Skills Toolkit - Environment Configuration Example
# ==============================================================================
# This template defines optional environment variables for local customization.
# NEVER commit real credentials, secrets, or API keys to version control.
# Copy this file to .env.local for local overrides if needed.
# ==============================================================================

# Custom Antigravity skills target directory (optional override)
ANTIGRAVITY_SKILLS_DIR=

# Optional API keys for custom tool integrations (leave blank in template)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local debugging and verbose installer logging (true/false)
ANTIGRAVITY_DEBUG=false
